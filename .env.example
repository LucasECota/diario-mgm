# Copie para .env e ajuste. Os valores abaixo são só de desenvolvimento; nunca versione segredos reais.

POSTGRES_USER=diario
POSTGRES_PASSWORD=diario_dev
POSTGRES_DB=diario_mgm

# Senha do usuário de banco da aplicação (sem UPDATE/DELETE na auditoria, ADR-003)
APP_DB_PASSWORD=diario_app_dev

# Portas publicadas no host
API_PORT=3000
WEB_PORT=8080
DB_PORT=5433

# Usados pelos testes rodando fora do Docker (banco diario_teste criado pelo compose)
DATABASE_URL=postgres://diario:diario_dev@localhost:5433/diario_teste
APP_DATABASE_URL=postgres://diario_app:diario_app_dev@localhost:5433/diario_teste
